generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
    moduleFormat    = "cjs"

}

datasource db {
  provider = "sqlserver"
}

model OrderItems {
  Id        Int      @id(map: "PK__OrderIte__3214EC075050284F") @default(autoincrement())
  OrderId   Int
  ProductId Int
  Quantity  Int
  UnitPrice Decimal  @db.Decimal(10, 2)
  Orders    Orders   @relation(fields: [OrderId], references: [Id], onUpdate: NoAction, map: "FK_OrderItems_Orders")
  Products  Products @relation(fields: [ProductId], references: [Id], onUpdate: NoAction, map: "FK_OrderItems_Products")
}

model Orders {
  Id         Int          @id(map: "PK__Orders__3214EC071957D621") @default(autoincrement())
  UserId     Int
  Total      Decimal      @db.Decimal(10, 2)
  Status     String       @default("CREATED", map: "DF__Orders__Status__403A8C7D") @db.NVarChar(50)
  CreatedAt  DateTime     @default(now(), map: "DF__Orders__CreatedA__412EB0B6")
  OrderItems OrderItems[]
  Users      Users        @relation(fields: [UserId], references: [Id], onUpdate: NoAction, map: "FK_Orders_Users")
}

model Products {
  Id          Int          @id(map: "PK__Products__3214EC075C62708B") @default(autoincrement())
  Name        String       @db.NVarChar(150)
  Description String?      @db.NVarChar(500)
  Price       Decimal      @db.Decimal(10, 2)
  Stock       Int
  IsActive    Boolean      @default(true, map: "DF__Products__IsActi__3C69FB99")
  CreatedAt   DateTime     @default(now(), map: "DF__Products__Create__3D5E1FD2")
  OrderItems  OrderItems[]
}

model Users {
  Id           Int      @id(map: "PK__Users__3214EC07627D40FE") @default(autoincrement())
  Email        String   @unique(map: "UQ__Users__A9D1053409C0697A") @db.NVarChar(150)
  PasswordHash String   @db.NVarChar(255)
  FullName     String   @db.NVarChar(150)
  IsActive     Boolean  @default(true, map: "DF__Users__IsActive__38996AB5")
  CreatedAt    DateTime @default(now(), map: "DF__Users__CreatedAt__398D8EEE")
  Orders       Orders[]
}
